{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RI Print",
  "version": "0.2.0",
  "identifier": "org.reliefinventory.print",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "RI Print",
        "width": 520,
        "height": 720,
        "minWidth": 420,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Print server for Relief Inventory",
    "longDescription": "Connects this computer's printers to a Relief Inventory server so staff can print labels and reports to them from the web app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["cups-client"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
