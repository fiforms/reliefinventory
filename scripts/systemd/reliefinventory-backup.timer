[Unit]
Description=Hourly check for a due Relief Inventory backup

[Timer]
# Fires hourly on purpose: update.sh --scheduled only hands the tick to the app
# (`backup:scheduled`), which decides from this warehouse's own schedule (the
# Warehouse Backups page) whether a snapshot is due, so the schedule can be changed
# in the app without touching systemd or needing root.
OnCalendar=*-*-* *:17:00
Persistent=true

[Install]
WantedBy=timers.target
