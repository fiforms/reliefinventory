APP_NAME=ReliefInventory
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

HOSTED_BY=reliefinventory.app
HOSTED_LINK=/about

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reliefinventory
DB_USERNAME=reliefinventory
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime (Laravel Reverb): instant print-queue updates and print-server wake-ups.
# Optional — leave BROADCAST_CONNECTION=log and everything falls back to polling.
# To enable: set it to `reverb`, fill in the REVERB_* values below (generate
# with `php artisan reverb:install`), run `php artisan reverb:start` under a
# supervisor, and proxy wss:// to it — see dev/notes/REVERB.md.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated developer addresses notified when an in-app feedback
# report (bug/feature request) is submitted. Leave empty to disable.
# The MAIL_* / RESEND_KEY settings and this list can also be set in the app
# (Setup > Email Settings); a value set there takes precedence over .env.
FEEDBACK_NOTIFY_EMAIL=

# Centralized feedback aggregation (multi-instance /setup/feedback triage)
# is configured from the admin UI now (/setup/feedback, manage-feedback) —
# see FeedbackAggregationSetting — not env vars.

# Set to false for a closed-network deployment (e.g. a LAN-only warehouse
# install with no internet access) — Turnstile requires reaching
# challenges.cloudflare.com and cannot function offline. Defaults to true.
CLOUDFLARE_TURNSTILE_ENABLED=true
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# geocod.io address/county lookup (People + Order Entry address fields).
# Optional and fails soft: GeocodioService::enabled() checks this key, and
# lookup() catches every error and returns null rather than throwing, so a
# missing/invalid/quota-exhausted key just silently disables auto-fill and
# address verification instead of breaking the form. Free tier is 2,500
# lookups/day — get a key at https://www.geocod.io.
GEOCODIO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PDF generation (labels, reports, forms) uses the weasyprint binary — no
# headless browser. Only set this if `weasyprint` isn't on the app's PATH.
# LARAVEL_PDF_WEASYPRINT_BINARY=/usr/bin/weasyprint

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Slow-query log (see config/slowlog.php, Setup > Testing Tools, `php artisan slowlog:show`).
# Milliseconds; queries slower than this, and whole slow/chatty/heavy requests, are recorded. 0 = off.
RI_SLOW_QUERY_MS=0
