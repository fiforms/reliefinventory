APP_NAME=ReliefInventory
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

HOSTED_BY=reliefinventory.app
HOSTED_LINK=/about

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reliefinventory
DB_USERNAME=reliefinventory
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated developer addresses notified when an in-app feedback
# report (bug/feature request) is submitted. Leave empty to disable.
FEEDBACK_NOTIFY_EMAIL=

# Set to false for a closed-network deployment (e.g. a LAN-only warehouse
# install with no internet access) — Turnstile requires reaching
# challenges.cloudflare.com and cannot function offline. Defaults to true.
CLOUDFLARE_TURNSTILE_ENABLED=true
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PDF generation (pallet labels, Situation Report) shells out to headless
# Chrome via spatie/browsershot. Chrome's own sandbox needs unprivileged
# user namespaces, which Ubuntu 23.10+ restricts under AppArmor by default —
# without this, PDF generation fails with "No usable sandbox!" even though
# all required shared libraries are installed. Safe here since the app
# already runs as an unprivileged user (www-data), not root.
LARAVEL_PDF_NO_SANDBOX=true

VITE_APP_NAME="${APP_NAME}"
