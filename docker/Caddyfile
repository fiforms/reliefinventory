# FrankenPHP (Caddy + embedded PHP) in plain "classic" mode: every request is a
# normal PHP request, exactly like php-fpm. TLS is deliberately off — put a
# reverse proxy (or your platform's ingress) in front for HTTPS.
{
	frankenphp
	auto_https off
	admin off
	# access log to stdout, errors to stderr
	log {
		output stderr
	}
}

:{$RI_HTTP_PORT:8080} {
	root * /var/www/html/public
	encode zstd gzip
	request_body {
		max_size 64MB
	}
	php_server
}
