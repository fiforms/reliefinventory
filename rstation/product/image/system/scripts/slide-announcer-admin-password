#!/usr/bin/env python3
"""Root helper: set or change the local admin account's (slideadmin) password.

Started on demand as slide-announcer-admin-password.service by the backend
(products/portal/backend/admin_password.py) when someone uses Settings >
Printers. That is the only way the unprivileged backend can reach it, and this
script — not the backend or the UI — is where the rules are enforced, so a bug
or exploit above it can't get around them:

  * No password has been set on this device yet (no marker, see MARKER): the
    first password needs no old one. A factory reset formats /data, which is
    where /etc's overlay lives, so it removes the marker and puts the build-time
    password back — the device is "first run" again, never locked out.
  * Otherwise the CURRENT password must be given and is checked against
    /etc/shadow here. Wrong guesses are slowed (DELAY_SECONDS, one at a time)
    and, after MAX_FAILURES in a row, refused for LOCK_SECONDS. The counter
    lives in /etc as well, so rebooting doesn't reset it.

Conversation with the backend, in /run/slide-announcer/admin-password (a tmpfs
directory the backend owns, so everything in it is untrusted input):
    request   {"old": str | null, "new": str}   deleted as soon as it is read
    result    {"code": "ok" | "wrong_password" | "locked" | "invalid_length" |
               "invalid_chars" | "error", "retry_after": seconds (locked only)}
The result never contains a password. Files there are opened relative to the
directory with O_NOFOLLOW and checked for owner/type/size, since root must not
be steered by what the backend's user plants (symlinks, FIFOs, huge files).

Installed root-owned into /usr/local/sbin and deliberately self-contained: it
must not import anything from /data/local-app, which the backend's user can
write.
"""
import ctypes
import ctypes.util
import fcntl
import hmac
import json
import os
import pwd
import stat
import subprocess
import sys
import time

ADMIN_USER = "slideadmin"
SERVICE_USER = "slideannouncer"
EXCHANGE_DIR = "/run/slide-announcer/admin-password"
STATE_DIR = "/etc/rstation"
MARKER = "admin-password-set"
FAILURES = "admin-password-failures.json"
LOCK = "admin-password.lock"
SHADOW = "/etc/shadow"

MIN_LENGTH, MAX_LENGTH = 8, 128
MAX_REQUEST_BYTES = 4096
DELAY_SECONDS = 3
MAX_FAILURES = 5
LOCK_SECONDS = 300


class Failure(Exception):
    def __init__(self, code, retry_after=None):
        super().__init__(code)
        self.code = code
        self.retry_after = retry_after


def _shadow_hash(user, shadow_path):
    with open(shadow_path) as f:
        for line in f:
            fields = line.rstrip("\n").split(":")
            if fields[0] == user and len(fields) > 1:
                return fields[1]
    return None


def verify_password(user, password, shadow_path=SHADOW):
    """True if `password` matches the user's current hash. Uses libcrypt directly
    so it handles whatever scheme the image uses (yescrypt, sha512, ...)."""
    stored = _shadow_hash(user, shadow_path)
    if not stored or stored[0] in "!*":  # no password / locked account
        return False
    libcrypt = ctypes.CDLL(ctypes.util.find_library("crypt") or "libcrypt.so.1")
    libcrypt.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
    libcrypt.crypt.restype = ctypes.c_char_p
    computed = libcrypt.crypt(password.encode(), stored.encode())
    return computed is not None and hmac.compare_digest(computed, stored.encode())


def run_chpasswd(user, password):
    """Password goes in on stdin, never on a command line."""
    result = subprocess.run(["chpasswd"], input=f"{user}:{password}\n", text=True, capture_output=True,
                            env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"}, timeout=20)
    if result.returncode != 0:
        raise Failure("error")


def _validate_new(new):
    if not isinstance(new, str) or not (MIN_LENGTH <= len(new) <= MAX_LENGTH):
        raise Failure("invalid_length")
    if any(ord(c) < 32 or ord(c) == 127 for c in new):
        raise Failure("invalid_chars")


class Helper:
    def __init__(self, state_dir=STATE_DIR, verify=verify_password, chpasswd=run_chpasswd, sleep=time.sleep, now=time.time):
        self.state_dir = state_dir
        self._verify = verify
        self._chpasswd = chpasswd
        self._sleep = sleep
        self._now = now

    def _path(self, name):
        return os.path.join(self.state_dir, name)

    def is_set(self):
        return os.path.exists(self._path(MARKER))

    def _failures(self):
        try:
            with open(self._path(FAILURES)) as f:
                data = json.load(f)
            return int(data.get("count", 0)), float(data.get("locked_until", 0))
        except (OSError, ValueError, TypeError, AttributeError):
            return 0, 0.0

    def _store_failures(self, count, locked_until):
        self._atomic_write(FAILURES, json.dumps({"count": count, "locked_until": locked_until}))

    def _atomic_write(self, name, content):
        os.makedirs(self.state_dir, mode=0o755, exist_ok=True)
        tmp = self._path(name + ".tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
        with os.fdopen(fd, "w") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, self._path(name))

    def handle(self, request):
        """Applies one request. Returns normally on success, raises Failure otherwise."""
        if not isinstance(request, dict):
            raise Failure("error")
        new, old = request.get("new"), request.get("old")
        _validate_new(new)

        if self.is_set():
            count, locked_until = self._failures()
            now = self._now()
            # A locked_until implausibly far ahead (the Pi has no battery clock; it can
            # jump) is not trusted past LOCK_SECONDS.
            if now < locked_until <= now + LOCK_SECONDS:
                raise Failure("locked", retry_after=int(locked_until - now) + 1)
            if locked_until:
                count = 0
            if not isinstance(old, str) or not self._verify(ADMIN_USER, old):
                count += 1
                self._store_failures(count, self._now() + LOCK_SECONDS if count >= MAX_FAILURES else 0)
                self._sleep(DELAY_SECONDS)
                if count >= MAX_FAILURES:
                    raise Failure("locked", retry_after=LOCK_SECONDS)
                raise Failure("wrong_password")

        self._chpasswd(ADMIN_USER, new)
        self._atomic_write(MARKER, f"{int(self._now())}\n")
        self._store_failures(0, 0)


def _open_exchange(path, service_uid):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    if os.fstat(fd).st_uid != service_uid:
        os.close(fd)
        raise Failure("error")
    return fd


def read_request(dir_fd, service_uid):
    try:
        fd = os.open("request", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
    except OSError:
        raise Failure("error")
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != service_uid or info.st_nlink != 1 or info.st_size > MAX_REQUEST_BYTES:
            raise Failure("error")
        data = os.read(fd, MAX_REQUEST_BYTES + 1)
    finally:
        os.close(fd)
        try:
            os.unlink("request", dir_fd=dir_fd)
        except OSError:
            pass
    try:
        return json.loads(data)
    except ValueError:
        raise Failure("error")


def write_result(dir_fd, code, retry_after=None):
    try:
        os.unlink("result", dir_fd=dir_fd)  # removes a planted symlink itself, never follows it
    except OSError:
        pass
    body = {"code": code}
    if retry_after is not None:
        body["retry_after"] = retry_after
    fd = os.open("result", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=dir_fd)
    with os.fdopen(fd, "w") as f:
        json.dump(body, f)


def main():
    if os.geteuid() != 0:
        print("must run as root", file=sys.stderr)
        return 2
    service_uid = pwd.getpwnam(SERVICE_USER).pw_uid
    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    # One request at a time: the failure counter and the delay only mean something serialised.
    lock = os.open(os.path.join(STATE_DIR, LOCK), os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            dir_fd = _open_exchange(EXCHANGE_DIR, service_uid)
        except (OSError, Failure):
            print("no usable exchange directory", file=sys.stderr)
            return 1
        try:
            try:
                Helper(state_dir=STATE_DIR, verify=verify_password, chpasswd=run_chpasswd).handle(read_request(dir_fd, service_uid))
                write_result(dir_fd, "ok")
            except Failure as failure:
                write_result(dir_fd, failure.code, failure.retry_after)
            except Exception as exc:  # never let a surprise leave the backend waiting, or print a password
                print(f"unexpected failure: {type(exc).__name__}", file=sys.stderr)
                write_result(dir_fd, "error")
        finally:
            os.close(dir_fd)
    finally:
        os.close(lock)  # releases the flock
    return 0


if __name__ == "__main__":
    sys.exit(main())
