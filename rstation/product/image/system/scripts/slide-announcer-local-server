#!/bin/bash
# Runs a complete Relief Inventory server (web app, queue worker, scheduler, MariaDB — the
# docker/compose.yaml stack) on this device, with no Internet: the images come from the .deb the
# image build baked into the root filesystem (rstation/build-offline-bundle.sh), and everything
# that matters lives under /data. Design and rules: rstation/LOCAL_SERVER.md.
#
#   run      the supervisor, as slide-announcer-local-server.service: start Docker, load the images
#            on first use, bring the stack up, keep /run/.../status.json current, and on SIGTERM
#            stop the stack gracefully (MariaDB gets time to shut down) and then Docker itself
#   enable   start-at-boot flag on, start the supervisor        (…-local-server-enable.service)
#   disable  flag off, stop the supervisor and so Docker        (…-local-server-disable.service)
#   reset    erase all server data, keeping the images           (…-local-server-reset.service)
#   update   pull the newest image of the chosen channel and restart onto it  (…-local-server-update.service)
#   status   print the status file
#
# The Settings > Local server page (backend/local_server.py) only ever starts those units, so the
# one thing it can ask for is one of those four actions, and nothing it sends is parsed here.
#
# Docker is only started while the flag exists: product/image/system/docker.{service,socket} are
# our own copies of the Debian units with ConditionPathExists on it, so a station that never
# uses this feature never runs a container engine. Exit status 3 means "don't retry" (no space,
# nothing to load); the unit does not restart on it.
#
# Which image runs: always the newest *version*. The image on the device is the baked-in one (loaded from
# the .deb) until an update pulls :latest from the registry over it; both use the same local tag
# (images.env's RI_APP_IMAGE, always ...:latest), and every image carries its release number as
# RI_VERSION. A newer baked build (an OS update) replaces what is in /data/docker only if its version is
# higher than what is installed there, and an update only installs a pulled image whose version is higher
# than what is running — so neither path can ever step backwards.
#
# Channels: $DATA/state/channel (written by the Settings page) is "latest" (official releases, the default) or "edge"
# (newer unreleased builds, for developers and testers). The image always runs under the one local tag
# (RI_APP_IMAGE); an update pulls the channel's tag from the registry and retags it. Edge images carry no release
# number, so on edge the "newer version only" rule becomes "a different image", and a baked-in build never
# replaces an installed edge image.
#
# RI_LOCAL_* and the binary variables exist for tests only.
set -uo pipefail

ROOT="${RI_LOCAL_ROOT:-/opt/relief-inventory}"      # the .deb's payload (read-only rootfs)
DATA="${RI_LOCAL_DATA:-/data/relief-inventory}"     # database, uploads, passwords, backups
RUN="${RI_LOCAL_RUN:-/run/slide-announcer/local-server}"
DOCKER_ROOT="${RI_LOCAL_DOCKER_ROOT:-/data/docker}"
SYSTEMCTL="${SYSTEMCTL:-systemctl}"
DOCKER="${DOCKER:-docker}"
CURL="${CURL:-curl}"
UNIT=slide-announcer-local-server.service
PORT="${RI_LOCAL_PORT:-8080}"
FLAG="$DATA/enabled"
STATUS="$RUN/status.json"
UPDATE_STATUS="$DATA/state/update.json"   # last/current update: phase, message, from, to (read by the Settings page)
UPDATE_LOCK="$RUN/update.lock"
CHANNEL_FILE="$DATA/state/channel"
MIN_UPDATE_FREE_BYTES="${RI_LOCAL_MIN_UPDATE_FREE_BYTES:-1000000000}"
UPDATE_WAIT_SECONDS="${RI_LOCAL_UPDATE_WAIT_SECONDS:-900}"   # migrations on an SD card can take minutes
# The uncompressed images (~1.6 GB) plus room for the database to grow; refusing early beats a
# half-loaded image and a full SD card.
MIN_FREE_BYTES="${RI_LOCAL_MIN_FREE_BYTES:-3000000000}"

log() { echo "[local-server] $*" >&2; }

json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\n\r\t'; }

# status PHASE "message" — phases: stopped, starting, loading-images, running, degraded, stopping, resetting, error
status() {
    mkdir -p "$RUN" && chmod 755 "$RUN"
    local code="" app="null"
    [ -r "$DATA/state/setup-code" ] && code="$(cat "$DATA/state/setup-code")"
    [ -r "$ROOT/manifest.json" ] && app="$(cat "$ROOT/manifest.json")"
    printf '{"phase":"%s","message":"%s","updated":%s,"port":%s,"setup_code":"%s","app":%s}\n' \
        "$1" "$(json_escape "${2:-}")" "$(date +%s)" "$PORT" "$(json_escape "$code")" "$app" > "$STATUS.tmp" \
        && chmod 644 "$STATUS.tmp" && mv -f "$STATUS.tmp" "$STATUS"
}

die() { # die EXITCODE "message"
    log "$2"
    status error "$2"
    docker_down   # nothing is running worth keeping the engine's memory for
    exit "$1"
}

compose() {
    if "$DOCKER" compose version >/dev/null 2>&1; then
        "$DOCKER" compose -p reliefinventory -f "$ROOT/compose.yaml" "$@"
    else
        docker-compose -p reliefinventory -f "$ROOT/compose.yaml" "$@"
    fi
}

free_bytes() { df --output=avail -B1 "$1" 2>/dev/null | tail -n1 | tr -d ' '; }

ensure_dirs() {
    mkdir -p "$DATA"/{db,storage,secrets,admin-secrets,warehouse-secrets,backups,state} "$DOCKER_ROOT"
    chmod 755 "$DATA"
}

docker_up() {
    "$SYSTEMCTL" start docker.socket docker.service || return 1
    local i
    for i in $(seq 1 60); do
        "$DOCKER" info >/dev/null 2>&1 && return 0
        sleep 1
    done
    return 1
}

docker_down() { "$SYSTEMCTL" stop docker.service docker.socket >/dev/null 2>&1; }

# The release number an image carries (RI_VERSION in its environment, set by the Docker build from the GitHub
# release tag), without a leading "v". Empty if the image isn't there or predates version stamping.
image_version() {
    local v
    v="$("$DOCKER" image inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$1" 2>/dev/null \
        | sed -n 's/^RI_VERSION=//p' | head -n1)"
    printf '%s' "${v#v}"
}

baked_version() { sed -n 's/.*"app_version": *"v\{0,1\}\([^"]*\)".*/\1/p' "$ROOT/manifest.json"; }

# version_gt A B — A is a strictly newer release than B. Unknown (empty) is older than anything.
version_gt() {
    [ -n "$1" ] || return 1
    [ -n "$2" ] || return 0
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]
}

# The release channel to follow: latest unless the Settings page chose edge.
channel() {
    local c=latest
    [ -r "$CHANNEL_FILE" ] && c="$(tr -d ' \n\r\t' < "$CHANNEL_FILE")"
    [ "$c" = edge ] && echo edge || echo latest
}

# What is installed, for the Settings page (which has no Docker access). Cleared if it can't be read.
record_version() {
    local v; v="$(image_version "$RI_APP_IMAGE")"
    if [ -n "$v" ]; then printf '%s' "$v" > "$DATA/state/app-version"; else rm -f "$DATA/state/app-version"; fi
}

# Loads the baked-in images the first time, and again after an OS update shipped a different build — but only
# when that build is a newer release than what is already installed (an update pulled from the registry may be
# ahead of it). The baked build's id is remembered either way, so a reboot doesn't re-decide.
load_images() {
    . "$ROOT/images.env"
    local want have="" present=0 installed baked
    want="$(sed -n 's/.*"app_image_id": *"\([^"]*\)".*/\1/p' "$ROOT/manifest.json")"
    [ -r "$DATA/state/loaded-image-id" ] && have="$(cat "$DATA/state/loaded-image-id")"
    "$DOCKER" image inspect "$RI_APP_IMAGE" "$RI_DB_IMAGE" >/dev/null 2>&1 && present=1
    if [ "$present" = 1 ] && [ -n "$want" ] && [ "$want" = "$have" ]; then
        record_version
        return 0
    fi
    if [ "$present" = 1 ]; then
        installed="$(image_version "$RI_APP_IMAGE")"
        baked="$(baked_version)"
        if [ "$(channel)" = edge ]; then
            log "keeping the installed server software: this device follows the edge channel"
            [ -n "$want" ] && printf '%s' "$want" > "$DATA/state/loaded-image-id"
            record_version
            return 0
        fi
        # Both unknown (a bundle from before versions were stamped): fall through and reload, as before.
        if { [ -n "$installed" ] || [ -n "$baked" ]; } && ! version_gt "$baked" "$installed"; then
            log "keeping the installed server software (${installed:-unknown}); the bundled one (${baked:-unknown}) is not newer"
            [ -n "$want" ] && printf '%s' "$want" > "$DATA/state/loaded-image-id"
            record_version
            return 0
        fi
    fi
    local free; free="$(free_bytes "$DOCKER_ROOT")"
    if [ -n "$free" ] && [ "$free" -lt "$MIN_FREE_BYTES" ]; then
        die 3 "Not enough free space on the device's data partition to unpack the server ($((free / 1000000)) MB free, $((MIN_FREE_BYTES / 1000000)) MB needed)."
    fi
    status loading-images "Unpacking the server software. This takes several minutes the first time."
    "$DOCKER" load -i "$ROOT/images.tar" >/dev/null &
    local pid=$!
    wait "$pid" || return 1
    # wait only reports the pipeline's last command; the load itself failing shows up as a missing image.
    "$DOCKER" image inspect "$RI_APP_IMAGE" "$RI_DB_IMAGE" >/dev/null 2>&1 || return 1
    printf '%s' "$want" > "$DATA/state/loaded-image-id"
    record_version
    "$DOCKER" image prune -f >/dev/null 2>&1   # an older build's layers
    return 0
}

# What compose.yaml's ${RI_*} placeholders mean on this device.
export_env() {
    . "$ROOT/images.env"
    export RI_APP_IMAGE RI_DB_IMAGE
    export RI_DATA="$DATA" RI_PORT="$PORT"
    export RI_APP_URL="${RI_LOCAL_APP_URL:-http://$(hostname).local:$PORT}"
    export RI_TIMEZONE; RI_TIMEZONE="$(timedatectl show -p Timezone --value 2>/dev/null || true)"
    : "${RI_TIMEZONE:=UTC}"
    # The server will be on a shared hotspot or switch, where anyone nearby could otherwise open
    # /install first and become its administrator. The code is shown only on this device's Settings page.
    if [ ! -s "$DATA/state/setup-code" ]; then
        (umask 077; LC_ALL=C tr -dc 'a-hj-km-np-z2-9' < /dev/urandom | head -c 8 > "$DATA/state/setup-code") 2>/dev/null
    fi
    RI_SETUP_CODE="$(cat "$DATA/state/setup-code")"; export RI_SETUP_CODE
}

app_is_up() { "$CURL" -fsS -o /dev/null --max-time 4 "http://127.0.0.1:$PORT/up" 2>/dev/null; }

shutting_down=0
shutdown() {
    [ "$shutting_down" = 1 ] && return; shutting_down=1
    status stopping "Stopping the server…"
    kill $(jobs -p) 2>/dev/null
    export_env 2>/dev/null
    # Graceful, with time for MariaDB to flush; a plain `docker stop` default of 10 s is too short on an SD card.
    compose stop -t 60 >/dev/null 2>&1
    docker_down
    status stopped "The server is stopped."
}

run() {
    [ -r "$ROOT/images.tar" ] && [ -r "$ROOT/compose.yaml" ] || die 3 "This image does not include the local server."
    ensure_dirs
    trap 'shutdown; exit 0' TERM INT
    status starting "Starting the container engine…"
    docker_up || die 1 "The container engine did not start. See: journalctl -u docker"
    load_images || die 1 "The server software could not be unpacked."
    export_env
    status starting "Starting the server…"
    compose up -d --no-build --pull never --remove-orphans >"$RUN/compose.log" 2>&1 &
    local up_pid=$! up_done=0
    while :; do
        if [ "$up_done" = 0 ] && ! kill -0 "$up_pid" 2>/dev/null; then
            up_done=1
            wait "$up_pid" || log "docker compose up failed: $(tail -n 3 "$RUN/compose.log" | tr '\n' ' ')"
        fi
        if app_is_up; then
            status running "The server is running."
        elif [ "$up_done" = 1 ] && [ -n "$(compose ps --status running -q app 2>/dev/null)" ]; then
            status starting "Starting the server… the first start takes a few minutes."
        elif [ "$up_done" = 1 ]; then
            status degraded "The server is not answering. It will keep trying."
        else
            status starting "Starting the server… the first start takes a few minutes."
        fi
        sleep 5 &
        wait $!
    done
}

# update_status PHASE "message" — phases: checking, downloading, installing, restarting (in progress);
# current, updated, failed (finished). The Settings page treats an in-progress phase with no running unit as interrupted.
UP_FROM="" UP_TO=""
update_status() {
    mkdir -p "$DATA/state"
    printf '{"phase":"%s","message":"%s","from":"%s","to":"%s","updated":%s}\n' \
        "$1" "$(json_escape "${2:-}")" "$(json_escape "$UP_FROM")" "$(json_escape "$UP_TO")" "$(date +%s)" \
        > "$UPDATE_STATUS.tmp" && mv -f "$UPDATE_STATUS.tmp" "$UPDATE_STATUS"
}
update_fail() { log "update: $1"; update_status failed "$1"; exit 1; }

wait_for_app() { # wait_for_app SECONDS
    local deadline=$((SECONDS + $1))
    while [ "$SECONDS" -lt "$deadline" ]; do
        app_is_up && return 0
        sleep 3
    done
    return 1
}

# Pulls the newest image of the chosen channel (latest or edge), tags it as the stack's own image, and restarts onto
# it, if — and only if — it is a newer release than the one running (on edge: a different build). Needs the server started (Docker only runs then). The app container takes its own
# database backup before applying migrations and refuses to start if the database is ahead of it (docker/entrypoint.sh).
update() {
    mkdir -p "$RUN" "$DATA/state"
    exec 9>"$UPDATE_LOCK"
    flock -n 9 || { log "an update is already running"; exit 0; }
    [ -r "$ROOT/images.env" ] || update_fail "This image does not include the local server."
    . "$ROOT/images.env"
    UP_FROM="$(image_version "$RI_APP_IMAGE")"
    update_status checking "Checking for a newer version…"

    "$SYSTEMCTL" is-active --quiet "$UNIT" && "$DOCKER" info >/dev/null 2>&1 \
        || update_fail "Start the local server first; updates are installed while it is running."
    local host="${RI_APP_IMAGE%%/*}" free
    "$CURL" -sS -o /dev/null --max-time 10 "https://$host/v2/" 2>/dev/null \
        || update_fail "Couldn't reach $host. Connect this device to the Internet and try again."
    free="$(free_bytes "$DOCKER_ROOT")"
    if [ -n "$free" ] && [ "$free" -lt "$MIN_UPDATE_FREE_BYTES" ]; then
        update_fail "Not enough free space to download an update ($((free / 1000000)) MB free, $((MIN_UPDATE_FREE_BYTES / 1000000)) MB needed)."
    fi

    local chan pull_ref; chan="$(channel)"
    pull_ref="${RI_APP_IMAGE%:*}:$chan"
    local old_id; old_id="$("$DOCKER" image inspect --format '{{.Id}}' "$RI_APP_IMAGE" 2>/dev/null)"
    # Put the running image back under the tag: an image that is not newer must never stay on it.
    restore_tag() { [ -n "$old_id" ] && "$DOCKER" tag "$old_id" "$RI_APP_IMAGE" >/dev/null 2>&1; }

    update_status downloading "Downloading the newest version… this can take several minutes."
    if ! timeout 3000 "$DOCKER" pull "$pull_ref" >"$RUN/update.log" 2>&1; then
        restore_tag
        update_fail "The download did not finish: $(tail -n 1 "$RUN/update.log" | cut -c1-160)"
    fi
    local new_id new_version
    # latest pulls straight onto the stack's tag; edge is pulled under its own tag and then retagged onto it
    [ "$pull_ref" != "$RI_APP_IMAGE" ] && "$DOCKER" tag "$pull_ref" "$RI_APP_IMAGE" >/dev/null 2>&1
    new_id="$("$DOCKER" image inspect --format '{{.Id}}' "$RI_APP_IMAGE" 2>/dev/null)"
    new_version="$(image_version "$RI_APP_IMAGE")"
    UP_TO="$new_version"
    if [ -n "$old_id" ] && [ "$new_id" = "$old_id" ]; then
        update_status current "This is already the newest version${UP_FROM:+ ($UP_FROM)}."
        exit 0
    fi
    if [ -z "$new_version" ] && [ "$chan" != edge ]; then
        restore_tag; "$DOCKER" image prune -f >/dev/null 2>&1
        update_fail "The newest image has no version number, so it was not installed."
    fi
    if [ "$chan" != edge ] && ! version_gt "$new_version" "$UP_FROM"; then
        restore_tag; "$DOCKER" image prune -f >/dev/null 2>&1
        update_status current "This is already the newest version (${UP_FROM:-unknown}); the registry has $new_version."
        exit 0
    fi

    local label="version $new_version"; [ -n "$new_version" ] || label="the newest edge build"
    update_status installing "Installing $label…"
    export_env
    compose up -d --no-build --pull never --remove-orphans >"$RUN/update.log" 2>&1
    update_status restarting "Starting $label… database updates can take a few minutes."
    if ! wait_for_app "$UPDATE_WAIT_SECONDS"; then
        # Put the previous version back. It will refuse to start if the new one already changed the database (the
        # entrypoint's downgrade check); the backup it took first is under Local server > backups.
        if [ -n "$old_id" ] && restore_tag; then
            compose up -d --no-build --pull never --remove-orphans >"$RUN/update.log" 2>&1
            if wait_for_app 180; then
                record_version
                update_fail "The $label did not start, so version ${UP_FROM:-the previous one} was put back. Try again later, or report this."
            fi
        fi
        update_fail "The $label did not start and the previous version could not be restored. Restart the device; a backup is in the backups list."
    fi
    record_version
    "$DOCKER" image prune -f >/dev/null 2>&1   # the replaced version's layers
    update_status updated "Updated to $label."
}

enable() {
    ensure_dirs
    touch "$FLAG"
    status starting "Starting…"
    "$SYSTEMCTL" start --no-block "$UNIT"
}

disable() {
    rm -f "$FLAG"
    "$SYSTEMCTL" stop --no-block "$UNIT"
}

reset() {
    status resetting "Erasing the server's data…"
    "$SYSTEMCTL" stop "$UNIT"        # graceful, and it stops Docker; the flag is still there so Docker can be started again below
    if docker_up; then
        export_env
        # Containers keep a bind mount to the database folder's old inode; they must go before it does.
        compose down --remove-orphans >/dev/null 2>&1
        docker_down
    fi
    rm -f "$FLAG"
    rm -rf "$DATA/db" "$DATA/storage" "$DATA/secrets" "$DATA/admin-secrets" "$DATA/warehouse-secrets" "$DATA/backups" "$DATA/state"
    ensure_dirs; rm -f "$FLAG"
    status stopped "The server's data was erased."
}

case "${1:-}" in
    run) run ;;
    enable) enable ;;
    disable) disable ;;
    reset) reset ;;
    update) update ;;
    status) cat "$STATUS" 2>/dev/null || echo '{"phase":"stopped"}' ;;
    *) echo "usage: $0 run|enable|disable|reset|update|status" >&2; exit 2 ;;
esac
