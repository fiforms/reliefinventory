[Unit]
Description=Set or change the local admin (slideadmin) password — started on demand by Settings > Printers
# Not enabled: the backend starts it per request. The name has to match
# slide-announcer-*.service for the platform's polkit rule to let the backend
# start it (system/polkit/50-slide-announcer-system.rules).

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/slide-announcer-admin-password
TimeoutStartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectHome=yes
